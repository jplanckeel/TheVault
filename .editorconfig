root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{kt,kts}]
# Compose functions are named like types.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Generated code (SQLDelight, ApiConfig) is not linted.
[**/build/**]
ktlint = disabled
ktlint_standard = disabled
