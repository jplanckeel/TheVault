-- Convert the legacy single condition into components.
UPDATE game SET has_media = 1, has_box = 0, has_manual = 0 WHERE condition_ = 'LOOSE';
UPDATE game SET has_media = 1, has_box = 1, has_manual = 0 WHERE condition_ = 'CIB_NO_MANUAL';
UPDATE game SET has_media = 1, has_box = 1, has_manual = 1 WHERE condition_ = 'CIB';
UPDATE game SET has_media = 1, has_box = 1, has_manual = 1, is_sealed = 1 WHERE condition_ = 'NEW_SEALED';
UPDATE game SET has_media = 1, media_grade = condition_ WHERE condition_ IN ('MINT', 'VERY_GOOD', 'GOOD', 'FAIR', 'POOR');
UPDATE game SET edition = 'COLLECTOR' WHERE is_collector_edition = 1;
UPDATE game SET edition = 'LIMITED' WHERE is_limited_edition = 1 AND is_collector_edition = 0;
UPDATE console SET has_media = 1, has_box = 0, has_manual = 0 WHERE condition_ = 'LOOSE';
UPDATE console SET has_media = 1, has_box = 1, has_manual = 0 WHERE condition_ = 'CIB_NO_MANUAL';
UPDATE console SET has_media = 1, has_box = 1, has_manual = 1 WHERE condition_ = 'CIB';
UPDATE console SET has_media = 1, has_box = 1, has_manual = 1, is_sealed = 1 WHERE condition_ = 'NEW_SEALED';
UPDATE console SET has_media = 1, media_grade = condition_ WHERE condition_ IN ('MINT', 'VERY_GOOD', 'GOOD', 'FAIR', 'POOR');
UPDATE console SET edition = 'COLLECTOR' WHERE is_collector_edition = 1;
UPDATE console SET edition = 'LIMITED' WHERE is_limited_edition = 1 AND is_collector_edition = 0;
UPDATE accessory SET has_media = 1, has_box = 0, has_manual = 0 WHERE condition_ = 'LOOSE';
UPDATE accessory SET has_media = 1, has_box = 1, has_manual = 0 WHERE condition_ = 'CIB_NO_MANUAL';
UPDATE accessory SET has_media = 1, has_box = 1, has_manual = 1 WHERE condition_ = 'CIB';
UPDATE accessory SET has_media = 1, has_box = 1, has_manual = 1, is_sealed = 1 WHERE condition_ = 'NEW_SEALED';
UPDATE accessory SET has_media = 1, media_grade = condition_ WHERE condition_ IN ('MINT', 'VERY_GOOD', 'GOOD', 'FAIR', 'POOR');
UPDATE accessory SET edition = 'COLLECTOR' WHERE is_collector_edition = 1;
UPDATE accessory SET edition = 'LIMITED' WHERE is_limited_edition = 1 AND is_collector_edition = 0;

CREATE TABLE item_tag (
    item_id TEXT NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (item_id, tag)
);

CREATE TABLE item_photo (
    id TEXT NOT NULL PRIMARY KEY,
    item_id TEXT NOT NULL,
    uri TEXT NOT NULL,
    created_at TEXT NOT NULL
);

CREATE INDEX item_photo_item ON item_photo(item_id);
