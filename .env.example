DATABASE_URL=postgres://postgres:postgres@localhost:5432/thevaultbo?sslmode=disable
PORT=8080
EBAY_BASE_URL=https://api.sandbox.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Comma-separated e-mails granted the admin role (back-office) when they register or log in
ADMIN_EMAILS=you@example.com
# Required, at least 32 characters: openssl rand -hex 32
JWT_SECRET=
# Mobile app key, at least 16 characters (empty disables mobile sync): openssl rand -hex 24
API_KEY=
EBAY_CRON=0 3 * * 0
IGDB_CRON=0 4 * * 0
POSTGRES_PASSWORD=
# Set to true only when the app is only reachable through a reverse proxy
TRUST_PROXY=false
# Extra browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=
